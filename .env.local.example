# Copy this file to .env.local and fill in the values you need.
# Nothing here is required to run `npm run dev` — the site degrades gracefully
# (blog shows an empty state) until Sanity is connected.

# --- Site URL (used in metadata, sitemap, JSON-LD) ---
# On Vercel this is auto-derived from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL
# if unset. Set explicitly for your real production domain.
NEXT_PUBLIC_SITE_URL=https://www.planourtravel.com

# --- Sanity (blog CMS) ---
# Create a free project at https://www.sanity.io/manage, then fill these in
# and restart the dev server. Visit /studio to start publishing posts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Write token (Manage → API → Tokens → Add API token, "Editor" role) — only
# needed to run `npm run seed:blog`, never exposed to the browser.
SANITY_API_TOKEN=

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID (G-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# --- Lead notification email (Resend) ---
# Without RESEND_API_KEY, inquiry/itinerary form submissions are only saved to
# data/leads/leads.jsonl (or /tmp on Vercel) — no email is sent.
# 1. Create a free account at https://resend.com and generate an API key.
# 2. Verify planourtravel.com (or a subdomain) as a sending domain in Resend —
#    until it's verified, RESEND_FROM_EMAIL must stay on Resend's shared
#    onboarding@resend.dev sender, which is fine for testing but looks less
#    trustworthy to recipients than a verified planourtravel.com address.
RESEND_API_KEY=
# Sender address once your domain is verified, e.g. "Plan Our Travel <leads@planourtravel.com>"
RESEND_FROM_EMAIL=
# Inbox that receives every form submission. Defaults to info@planourtravel.com if unset.
LEAD_NOTIFICATION_EMAIL=
